# Copy to backend/.env.deploy.local and chmod 600. Never commit the real file.
# REMOTE_DB_PASSWORD is required. Keep the real value only in the ignored local file.

DEPLOY_SSH_HOST=ssh-host.example.invalid
DEPLOY_SSH_USER=ssh-user
DEPLOY_SSH_KEY=
DEPLOY_REMOTE_APP_DIR=/home/www/STRATO-apps/wordpress_01/app

REMOTE_DB_HOST=database-host.example.invalid
REMOTE_DB_NAME=wordpress_database
REMOTE_DB_USER=wordpress_user
REMOTE_DB_PASSWORD=

PRODUCTION_WORDPRESS_URL=https://wordpress.example.invalid
PRODUCTION_FRONTEND_URL=https://www.example.invalid

# Running Lando Docker services used as the deployment source.
LOCAL_WP_CONTAINER=kubikartbackend_appserver_1
LOCAL_WP_PATH=/app/wordpress
