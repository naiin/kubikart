# Mailtrap Configuration
MAILTRAP_TOKEN=your_mailtrap_token_here
MAILTRAP_ACCOUNT_ID=123456

# Template UUIDs (created via Mailtrap Template API / dashboard)
# Visit: https://mailtrap.io/ → Email Templates
MAILTRAP_TEMPLATE_NEWSLETTER=00000000-0000-0000-0000-000000000001
MAILTRAP_TEMPLATE_NEWSLETTER_WELCOME=00000000-0000-0000-0000-000000000002
MAILTRAP_TEMPLATE_ORDER=00000000-0000-0000-0000-000000000003
MAILTRAP_TEMPLATE_PASSWORD_RESET=00000000-0000-0000-0000-000000000004
MAILTRAP_TEMPLATE_CONTACT=00000000-0000-0000-0000-000000000005
MAILTRAP_TEMPLATE_ACCOUNT_CREATED=00000000-0000-0000-0000-000000000006
MAILTRAP_TEMPLATE_ORDER_STATUS=00000000-0000-0000-0000-000000000007
MAILTRAP_TEMPLATE_LOGIN_ALERT=00000000-0000-0000-0000-000000000008

# Optional: status-specific template variants (fallback to MAILTRAP_TEMPLATE_ORDER_STATUS)
MAILTRAP_TEMPLATE_ORDER_STATUS_PENDING=00000000-0000-0000-0000-000000000009
MAILTRAP_TEMPLATE_ORDER_STATUS_PROCESSING=00000000-0000-0000-0000-000000000010
MAILTRAP_TEMPLATE_ORDER_STATUS_SHIPPED=00000000-0000-0000-0000-000000000011
MAILTRAP_TEMPLATE_ORDER_STATUS_DELIVERED=00000000-0000-0000-0000-000000000012
MAILTRAP_TEMPLATE_ORDER_STATUS_FAILED=00000000-0000-0000-0000-000000000013
MAILTRAP_TEMPLATE_ORDER_STATUS_REFUNDED=00000000-0000-0000-0000-000000000014

# Optional: legal PDF attachment paths (relative to frontend/public)
MAIL_PDF_AGB_PATH=legal/agb.pdf
MAIL_PDF_WIDERRUF_PATH=legal/widerruf.pdf

# WordPress Configuration
NEXT_PUBLIC_WORDPRESS_URL=https://kubikart-backend.lndo.site
NEXT_PUBLIC_SITE_URL=https://kubikart-frontend.vercel.app
# Server-only authenticated REST integration for published Business Industries.
WORDPRESS_API_URL=https://kubikart-backend.lndo.site/wp-json/wp/v2
# Use a least-privileged Application Password account. Never use NEXT_PUBLIC_.
WP_APP_USER=app_user
WP_APP_PASSWORD=app_password_here

# Stripe & PayPal (existing)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
PAYPAL_CLIENT_ID=client_id_here
PAYPAL_CLIENT_SECRET=client_secret_here

# Optional: Contact Form 7 (if using CF7 for contact emails)
CF7_FORM_ID=123
