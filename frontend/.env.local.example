# Mailtrap Configuration
MAILTRAP_TOKEN=replace-with-mailtrap-runtime-token
MAILTRAP_ACCOUNT_ID=replace-with-mailtrap-account-id

# Template UUIDs (created via Mailtrap Template API / dashboard)
# Visit: https://mailtrap.io/ → Email Templates
MAILTRAP_TEMPLATE_NEWSLETTER=replace-with-template-uuid
MAILTRAP_TEMPLATE_NEWSLETTER_WELCOME=replace-with-template-uuid
MAILTRAP_TEMPLATE_ORDER=replace-with-template-uuid
MAILTRAP_TEMPLATE_PASSWORD_RESET=replace-with-template-uuid
MAILTRAP_TEMPLATE_CONTACT=replace-with-template-uuid
MAILTRAP_TEMPLATE_ACCOUNT_CREATED=replace-with-template-uuid
MAILTRAP_TEMPLATE_ORDER_STATUS=replace-with-template-uuid
MAILTRAP_TEMPLATE_LOGIN_ALERT=replace-with-template-uuid
MAILTRAP_TEMPLATE_WITHDRAWAL=replace-with-template-uuid

# Optional: status-specific template variants (fallback to MAILTRAP_TEMPLATE_ORDER_STATUS)
MAILTRAP_TEMPLATE_ORDER_STATUS_PENDING=replace-with-template-uuid
MAILTRAP_TEMPLATE_ORDER_STATUS_PROCESSING=replace-with-template-uuid
MAILTRAP_TEMPLATE_ORDER_STATUS_SHIPPED=replace-with-template-uuid
MAILTRAP_TEMPLATE_ORDER_STATUS_DELIVERED=replace-with-template-uuid
MAILTRAP_TEMPLATE_ORDER_STATUS_FAILED=replace-with-template-uuid
MAILTRAP_TEMPLATE_ORDER_STATUS_REFUNDED=replace-with-template-uuid

# Optional: legal PDF attachment paths (relative to frontend/public)
MAIL_PDF_AGB_PATH=legal/agb.pdf
MAIL_PDF_WIDERRUF_PATH=legal/widerruf.pdf

# WordPress Configuration
NEXT_PUBLIC_WORDPRESS_URL=https://wordpress-staging.example.invalid
NEXT_PUBLIC_SITE_URL=https://frontend-staging.example.invalid
# Server-only authenticated REST integration for published Business Industries.
WORDPRESS_API_URL=https://wordpress-staging.example.invalid/wp-json/wp/v2
# Use a least-privileged Application Password account. Never use NEXT_PUBLIC_.
WP_APP_USER=replace-with-integration-username
WP_APP_PASSWORD=replace-with-application-password

# WooCommerce REST API (server-only)
WC_API_URL=https://wordpress-staging.example.invalid/wp-json/wc/v3
WC_CONSUMER_KEY=replace-with-restricted-consumer-key
WC_CONSUMER_SECRET=replace-with-restricted-consumer-secret

# At least 32 random characters. Generate separately for each environment.
# Example command: openssl rand -base64 48
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-sandbox-publishable-key
STRIPE_SECRET_KEY=replace-with-sandbox-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-sandbox-webhook-signing-secret

# PayPal. Set PAYPAL_MODE=live only with live credentials and webhook.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_SECRET=replace-with-sandbox-client-secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=replace-with-sandbox-webhook-id

# Signed WooCommerce cache-revalidation webhook
# Must equal WordPress KUBIKART_REVALIDATE_SECRET; both are server-only.
REVALIDATE_SECRET=replace-with-random-revalidation-secret

# Distributed API rate limiting (recommended and required for multi-instance production).
# When omitted locally, the app uses a process-local development fallback.
UPSTASH_REDIS_REST_URL=https://redis-staging.example.invalid
UPSTASH_REDIS_REST_TOKEN=replace-with-redis-rest-token

# Shipping prices and free-shipping policy
FREE_SHIPPING_THRESHOLD=50
DHL_PRICE_KLEINPAKET=3.99
DHL_PRICE_PAKET=5.49
DHL_PRICE_INTERNATIONAL=8.99

# DHL Business API and sender data (required only for label creation)
DHL_API_URL=https://api-eu.dhl.com/parcel/de/shipping/v2
DHL_API_KEY=replace-with-dhl-api-key
DHL_USERNAME=replace-with-dhl-username
DHL_PASSWORD=replace-with-dhl-password
# Dedicated secret for the internal shipping-label endpoint. Do not expose it to browsers.
DHL_LABEL_SECRET=replace-with-random-label-endpoint-secret
DHL_BILLING_NUMBER_PAKET=replace-with-billing-number
DHL_BILLING_NUMBER_KLEINPAKET=replace-with-billing-number
DHL_BILLING_NUMBER_INTERNATIONAL=replace-with-billing-number
DHL_BILLING_NUMBER_RETURN=replace-with-billing-number
DHL_SENDER_NAME=Kubikart
DHL_SENDER_STREET=replace-with-sender-street
DHL_SENDER_STREET_NUMBER=replace-with-sender-number
DHL_SENDER_POSTAL_CODE=replace-with-sender-postcode
DHL_SENDER_CITY=replace-with-sender-city

# Optional: Contact Form 7 (if using CF7 for contact emails)
CF7_FORM_ID=replace-with-form-id
